---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { Project } from '../lib/projects';
import Icon from './Icon.astro';
interface Props { project: Project }
const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---
<div class="project-expanded" id={`content-${project.id}`}>
  <div class="expanded-main">
    <div class="prose"><Content /></div>
    {(data.cover || data.gallery.length > 0) && <div class="project-media">
      {data.cover && <figure><Image src={data.cover} alt={data.coverAlt!} widths={[480, 768, 1200]} sizes="(max-width: 767px) 90vw, 700px" loading="lazy" /><figcaption>{data.coverCaption}</figcaption></figure>}
      {data.gallery.map((media) => <figure><Image src={media.image} alt={media.alt} widths={[480, 768, 1200]} sizes="(max-width: 767px) 90vw, 700px" loading="lazy" /><figcaption>{media.caption}</figcaption></figure>)}
    </div>}
  </div>
  <aside class="expanded-aside" aria-label={`${data.title} skills and links`}>
    <p class="eyebrow">Tools & topics</p><ul class="tags">{data.tags.map((tag) => <li>{tag}</li>)}</ul>
    {data.confidential && <p class="confidential-note">Code not public<span>Only high-level methods are described.</span></p>}
    {data.links.length > 0 && <div class="case-links"><p class="eyebrow">Project links</p>{data.links.map((link) => <a class="text-link" href={link.url}>{link.label}<Icon name="diagonal" size={16} /></a>)}</div>}
  </aside>
</div>

---
interface Props { number?: string; title: string; description?: string; id?: string }
const { number, title, description, id } = Astro.props;
---
<div class="section-heading">
  <div class="section-title">{number && <span class="section-number" aria-hidden="true">{number} /</span>}<h2 id={id}>{title}</h2></div>
  {description && <p>{description}</p>}
</div>

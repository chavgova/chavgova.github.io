---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';
import { categories } from '../../content.config';
const projects = await getProjects();
const filters = categories.filter((category) => projects.some(({ data }) => data.categories.includes(category)));
const current = projects.filter(({ data }) => !data.categories.includes('Earlier Work'));
const earlier = projects.filter(({ data }) => data.categories.includes('Earlier Work'));
---
<BaseLayout title="Projects" description="Explore Gabriela Chavgova’s machine learning projects: applied NLP, scientific software, interpretability, diffusion models, and earlier robotics research.">
  <div class="container page-content">
    <header class="page-heading"><p class="eyebrow">Research / Engineering / Practice</p><h1>Work, in detail<span class="accent">.</span></h1><p>Industry systems, controlled experiments, and the prototypes that started it all.</p></header>
    <div class="project-filters" hidden data-filters><p class="filter-label">Explore by focus</p><div class="filter-buttons" role="group" aria-label="Filter projects"><button type="button" data-filter="All" aria-pressed="true">All</button>{filters.map((filter) => <button type="button" data-filter={filter} aria-pressed="false">{filter}</button>)}</div><p class="filter-count" role="status" aria-live="polite">{projects.length} projects</p></div>
    <div data-project-group><h2 class="catalogue-heading">Selected engineering & research</h2><div class="project-list">{current.map((project) => <ProjectCard project={project} />)}</div></div>
    <div class="earlier-section" data-project-group><h2 class="catalogue-heading">Earlier Work</h2><p class="catalogue-description">The early research and physical prototypes behind my engineering practice.</p><div class="project-list">{earlier.map((project) => <ProjectCard project={project} />)}</div></div>
  </div>
</BaseLayout>
<script>
  const filters = document.querySelector<HTMLElement>('[data-filters]')!;
  const buttons = filters.querySelectorAll<HTMLButtonElement>('button');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-card]'));
  filters.hidden = false;
  const applyFilter = (active: string) => {
    // One active filter; a multi-category project matches membership, never duplicates.
    buttons.forEach((other) => other.setAttribute('aria-pressed', String(other.dataset.filter === active)));
    cards.forEach((card) => { card.hidden = active !== 'All' && !(JSON.parse(card.dataset.categories!) as string[]).includes(active); });
    document.querySelectorAll<HTMLElement>('[data-project-group]').forEach((group) => { group.hidden = !Array.from(group.querySelectorAll<HTMLElement>('[data-project-card]')).some((card) => !card.hidden); });
    const count = cards.filter((card) => !card.hidden).length;
    filters.querySelector('[role="status"]')!.textContent = `${count} ${count === 1 ? 'project' : 'projects'}`;
  };
  buttons.forEach((button) => button.addEventListener('click', () => applyFilter(button.dataset.filter!)));
  cards.forEach((card) => {
    const details = card.querySelector<HTMLDetailsElement>('details')!;
    details.querySelector('summary')!.setAttribute('aria-expanded', String(details.open));
    details.addEventListener('toggle', () => {
      details.querySelector('summary')!.setAttribute('aria-expanded', String(details.open));
      if (details.open) history.replaceState(null, '', `#${card.id}`);
      else if (location.hash === `#${card.id}`) history.replaceState(null, '', location.pathname + location.search);
    });
    details.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && details.open) {
        details.open = false;
        details.querySelector<HTMLElement>('summary')!.focus();
      }
    });
  });
  const openLinkedProject = () => {
    let id: string;
    try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
    const card = cards.find((item) => item.id === id);
    if (!card) return;
    applyFilter('All');
    const details = card.querySelector<HTMLDetailsElement>('details')!;
    details.open = true;
    requestAnimationFrame(() => {
      card.scrollIntoView({ block: 'start', behavior: 'instant' });
      details.querySelector<HTMLElement>('summary')!.focus({ preventScroll: true });
    });
  };
  window.addEventListener('hashchange', openLinkedProject);
  openLinkedProject();
</script>
